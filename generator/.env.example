# Python VIP 제너레이터 환경변수
# 실제 값은 .env 파일에 복사 후 입력 (git에 절대 커밋 금지)

# Claude API (LLM 생성용)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (DB 읽기/쓰기)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (이메일 발송)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@saju7.kr

# 운세위키 API (사주 16종 데이터)
SAJU_API_KEY=sb_...
SAJU_API_URL=https://luckyloveme.com/api/saju-full-analysis

# 사이트 URL (이메일 링크용)
SITE_URL=https://www.saju7.kr

# 사용할 Claude 모델 (기본값: claude-opus-4-5)
# 선택지: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-4-5
LLM_MODEL=claude-opus-4-5
