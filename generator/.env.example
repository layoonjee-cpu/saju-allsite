# Python VIP 제너레이터 환경변수
# 실제 값은 .env 파일에 복사 후 입력 (git에 절대 커밋 금지)

# OpenAI API (LLM 생성용)
OPENAI_API_KEY=sk-proj-...

# Supabase (DB 읽기/쓰기)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (이메일 발송)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@saju7.kr

# 운세위키 API (사주 16종 데이터)
SAJU_API_KEY=sb_...
SAJU_API_URL=https://luckyloveme.com/api/saju-full-analysis

# 사이트 URL (이메일 링크용)
SITE_URL=https://www.saju7.kr

# 사용할 OpenAI 모델 (기본값: gpt-4o)
# 선택지: gpt-4o, gpt-4o-mini, gpt-4-turbo
LLM_MODEL=gpt-4o
